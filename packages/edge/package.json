{
	"name": "@fasteejs/edge",
	"version": "1.0.2",
	"description": "blazing fast web application framework",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pouchlabs/fasteejs.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"demo": "node --watch src/lib/demo.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.3",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"publint": "^0.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^5.4.11",
		"vitest": "^2.0.4"
	},
	"keywords": [
		"fasteejs",
		"api",
		"backend",
		"http",
		"web",
		"app",
		"application",
		"framework",
		"router",
		"cloudflare",
		"websocket",
		"ws",
		"rest",
		"nodejs",
		"bun",
		"workers",
		"deno",
		"edge"
	],
	"author": "pouchlabs",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/pouchlabs/fasteejs/issues"
	},
	"homepage": "https://fasteejs.top",
	"dependencies": {
		"cookie": "^1.0.2",
		"esm-env": "^1.2.2",
		"eventemitter3": "^5.0.1",
		"mrmime": "^2.0.0",
		"nanoid": "^5.1.0",
		"totalist": "^3.0.1"
	}
}
